# SailPoint Identity Security Cloud Configuration
# Copy this file to .env and fill in your credentials

# Your SailPoint ISC tenant name (e.g., "your-company" from "https://your-company.identitynow.com")
SAILPOINT_TENANT=your-tenant-name

# Client ID from your SailPoint Personal Access Token (PAT)
SAILPOINT_CLIENT_ID=your-client-id

# Client Secret from your SailPoint Personal Access Token (PAT)
SAILPOINT_CLIENT_SECRET=your-client-secret

# SailPoint API Base URL (usually no need to change)
SAILPOINT_BASE_URL=https://sailpoint.api.identitynow.com

# Server port (optional, defaults to 3000)
PORT=3000
